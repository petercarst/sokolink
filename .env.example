# =============================================================================
#  SokoLink - environment configuration EXAMPLE
#  Copy to .env and edit.  .env is git-ignored and must never be committed.
# =============================================================================

# ---- Application ---------------------------------------------------------
APP_NAME="SokoLink"
APP_ENV=local                  # local | production
APP_DEBUG=true                 # MUST be false in production
APP_URL=http://localhost/e-commerce
APP_TIMEZONE=UTC               # Storage timezone. Never change this.
APP_DISPLAY_TIMEZONE=Africa/Dar_es_Salaam
APP_LOCALE=en
APP_CURRENCY=TZS
APP_CURRENCY_SYMBOL=TSh

# Leave blank to auto-detect. Set only if auto-detection fails.
APP_BASE_PATH=

# 32+ random chars. Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# ---- Database (Phase 2) --------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sokolink
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ---- Session -------------------------------------------------------------
SESSION_NAME=sokolink_session
SESSION_LIFETIME_MINUTES=120
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_SECURE=false           # true in production (HTTPS only)
SESSION_SAME_SITE=Lax

# ---- Authentication / throttling (Phase 3) -------------------------------
AUTH_LOGIN_MAX_ATTEMPTS=5      # failures allowed per identifier per window
AUTH_LOGIN_DECAY_MINUTES=15    # the window
AUTH_LOCKOUT_MINUTES=15        # how long a tripped throttle holds
AUTH_RESET_TOKEN_MINUTES=60
AUTH_VERIFY_TOKEN_HOURS=48
AUTH_PASSWORD_MIN_LENGTH=10

# ---- Mail (Phase 3) ------------------------------------------------------
MAIL_DRIVER=log                # log | smtp   ("log" writes to storage/logs)
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@sokolink.test
MAIL_FROM_NAME="SokoLink"

# ---- Payments (Phase 3) --------------------------------------------------
# v1 ships a SANDBOX driver only. No live provider is connected.
PAYMENT_DRIVER=sandbox         # sandbox | cash
# Signs and verifies sandbox callbacks. A callback that does not verify is
# recorded and IGNORED, so leaving this blank makes the endpoint refuse
# everything - which is the safe default, not a bug. The value below is a
# development placeholder for the simulated driver; a real provider issues its
# own secret and it belongs in .env, never here.
PAYMENT_WEBHOOK_SECRET=dev-sandbox-signing-key-change-me
PAYMENT_UNPAID_EXPIRY_MINUTES=60

# ---- Notifications / retention (Phase 3) ---------------------------------
NOTIFY_QUIET_HOURS_START=21
NOTIFY_QUIET_HOURS_END=7
REMINDER_COOLDOWN_DAYS=14
REMINDER_MONTHLY_CAP=4

# ---- Uploads -------------------------------------------------------------
UPLOAD_MAX_BYTES=3145728       # 3 MB
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp
